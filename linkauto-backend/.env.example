# Copy to .env for local runs (`cp .env.example .env`). Every value has a development default
# in app/core/config.py; production must override at least JWT_SECRET and DATABASE_URL.

APP_ENV=development
API_V1_PREFIX=/api/v1
APP_NAME=LinkAuto API

# SQLite (development, re-created and seeded on startup when RESET_SQLITE_ON_STARTUP=true):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL + PostGIS (staging/production) via psycopg 3. Plain postgresql:// URLs are
# rewritten to postgresql+psycopg:// automatically:
# DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password@postgres:5432/linkauto
RESET_SQLITE_ON_STARTUP=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a real secret outside development, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# SES_FROM_EMAIL=
