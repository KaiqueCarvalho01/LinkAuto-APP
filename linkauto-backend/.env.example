# Copy to .env for local runs (`cp .env.example .env`). Every value has a development default
# in app/core/config.py; production must override at least JWT_SECRET and DATABASE_URL.

APP_ENV=development
API_V1_PREFIX=/api/v1
APP_NAME=LinkAuto API

# SQLite (development, re-created and seeded on startup when RESET_SQLITE_ON_STARTUP=true):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL + PostGIS (staging/production) via psycopg 3. Plain postgresql:// URLs are
# rewritten to postgresql+psycopg:// automatically:
# DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password@postgres:5432/linkauto
RESET_SQLITE_ON_STARTUP=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting. Redis is OPTIONAL: memory:// counts per process (fine for a single worker);
# redis://... shares the counters across workers and replicas.
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# IPs/CIDRs of the reverse proxy / load balancer allowed to set X-Forwarded-For. Leave empty
# when clients connect directly; never use a wildcard.
# TRUSTED_PROXIES=10.0.0.0/8

# Generate a real secret outside development, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

AWS_REGION=us-east-1
# Leave the keys unset to use the default AWS credential chain (IAM role, profile, ...)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Instructor documents. S3 is OPTIONAL: DOCUMENT_STORAGE=auto uses the private S3_BUCKET when
# set and the local disk (DOCUMENT_STORAGE_PATH) otherwise. Options: auto | s3 | local | memory.
# DOCUMENT_STORAGE=auto
# S3_BUCKET=linkauto-documents
# DOCUMENT_STORAGE_PATH=./storage
# Public base URL of the API, used for links to locally stored documents
# PUBLIC_API_URL=http://localhost:8000

# E-mail notifications are OPTIONAL. EMAIL_BACKEND=auto sends through AWS SES when
# SES_FROM_EMAIL is set; without it, e-mails are kept in memory in development/tests and
# skipped (logged at INFO) elsewhere. Options: auto | ses | memory | disabled.
# EMAIL_BACKEND=auto
# SES_FROM_EMAIL=no-reply@linkauto.com.br
